generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id
  name                String
  email               String               @unique
  emailVerified       Boolean
  image               String?
  planId              String               @default("free")
  credits             Int                  @default(150)
  creditResetDate     DateTime?
  stripeCustomerId    String?
  autoRechargeEnabled Boolean?
  rechargeThreshold   Int?
  rechargeAmount      Int?
  createdAt           DateTime
  updatedAt           DateTime
  sessions            Session[]
  accounts            Account[]
  legacyIdentityLink  LegacyIdentityLink?
  agents              Agent[]
  chatSessions        ChatSession[]
  messageFeedback     MessageFeedback[]
  leads               Lead[]
  emailSessions       EmailSession[]
  emailMessages       EmailMessage[]
  creditTransactions  CreditTransaction[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model LegacyIdentityLink {
  id           String   @id @default(cuid())
  authUserId   String   @unique
  legacyUserId String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [authUserId], references: [id], onDelete: Cascade)

  @@index([legacyUserId])
  @@map("legacy_identity_link")
}

model Agent {
  id                      String      @id
  ownerUserId             String
  legacyOwnerId           String?
  name                    String
  description             String      @default("")
  instructions            String?
  status                  String      @default("idle")
  temperature             Float?
  welcomeMessage          String?
  inCallWelcomeMessage    String?
  isWelcomeMessageEnabled Boolean?
  isDisplayNameEnabled    Boolean?
  logoUrl                 String?
  themeColor              String?
  chatButtonColor         String?
  chatBubbleAlignment     String?
  chatInputPlaceholder    String?
  isFeedbackEnabled       Boolean?
  isBargeInEnabled        Boolean?
  isBrandingEnabled       Boolean?
  agentVoice              String?
  emailSignature          String?
  handoffEmail            String?
  conversationStarters    Json?
  goals                   Json?
  tasks                   Json?
  rateLimiting            Json?
  orbColors               Json?
  phoneConfig             Json?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  lastModified            DateTime?
  deletedAt               DateTime?
  owner                   User        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  texts                   AgentText[]
  files                   AgentFile[]
  chatSessions            ChatSession[]
  messageFeedback         MessageFeedback[]
  leads                   Lead[]
  emailSessions           EmailSession[]
  configurationLogs       ConfigurationLog[]
  interactionLogs         InteractionLog[]
  workflows               Workflow[]

  @@index([ownerUserId, updatedAt])
  @@index([legacyOwnerId])
  @@map("agent")
}

model AgentText {
  id        String   @id
  agentId    String
  title      String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@map("agent_text")
}

model AgentFile {
  id           String   @id
  agentId       String
  name          String
  type          String
  size          Int
  url           String
  storagePath   String
  extractedText String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@map("agent_file")
}

model ChatSession {
  id                 String            @id
  agentId            String
  ownerUserId        String
  legacyOwnerId      String?
  visitorId          String?
  title              String
  lastMessageSnippet String
  createdAt          DateTime          @default(now())
  lastActivity       DateTime
  lastLeadAnalysisAt DateTime?
  visitorInfo        Json?
  source             String            @default("chat")
  deletedAt          DateTime?
  agent              Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  owner              User              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  messages           ChatMessage[]
  feedback           MessageFeedback[]

  @@index([agentId, lastActivity])
  @@index([agentId, visitorId, lastActivity])
  @@index([ownerUserId, lastActivity])
  @@index([legacyOwnerId])
  @@map("chat_session")
}

model ChatMessage {
  id         String      @id
  sessionId  String
  sender     String
  text       String
  timestamp  DateTime    @default(now())
  options    Json?
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
  @@map("chat_message")
}

model MessageFeedback {
  id          String      @id @default(cuid())
  agentId      String
  ownerUserId  String
  legacyOwnerId String?
  sessionId    String
  messageId    String
  rating       String
  comment      String?
  createdAt    DateTime    @default(now())
  agent        Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  owner        User        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([agentId, sessionId, createdAt])
  @@index([ownerUserId, createdAt])
  @@index([legacyOwnerId])
  @@map("message_feedback")
}

model Lead {
  id            String    @id
  agentId        String
  ownerUserId    String
  legacyOwnerId  String?
  sessionId      String?
  name           String?
  email          String?
  phone          String?
  summary        String?
  source         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  agent          Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  owner          User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([ownerUserId, createdAt])
  @@index([legacyOwnerId])
  @@index([sessionId])
  @@map("lead")
}

model EmailSession {
  id                 String         @id
  agentId            String
  ownerUserId        String
  legacyOwnerId      String?
  subject            String
  participantEmail   String
  participants       Json?
  status             String         @default("open")
  lastMessageSnippet String?
  createdAt          DateTime       @default(now())
  lastActivity       DateTime
  deletedAt          DateTime?
  agent              Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  owner              User           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  messages           EmailMessage[]

  @@index([agentId, lastActivity])
  @@index([agentId, participantEmail, lastActivity])
  @@index([ownerUserId, lastActivity])
  @@index([legacyOwnerId])
  @@map("email_session")
}

model EmailMessage {
  id              String       @id
  sessionId       String
  ownerUserId     String
  legacyOwnerId   String?
  messageId       String?
  sender          String
  recipient       String?
  text            String
  direction       String
  deliveryStatus  String?
  providerPayload Json?
  createdAt       DateTime     @default(now())
  session         EmailSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  owner           User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([ownerUserId, createdAt])
  @@index([legacyOwnerId])
  @@index([messageId])
  @@map("email_message")
}

model ConfigurationLog {
  id          String   @id @default(cuid())
  agentId     String
  title       String
  description String
  actor       String
  timestamp   DateTime @default(now())
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, timestamp])
  @@map("configuration_log")
}

model InteractionLog {
  id        String               @id @default(cuid())
  agentId   String
  title     String
  origin    String
  status    String               @default("in-progress")
  sessionId String?
  metadata  Json?
  timestamp DateTime             @default(now())
  agent     Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  steps     InteractionLogStep[]

  @@index([agentId, timestamp])
  @@index([agentId, sessionId])
  @@map("interaction_log")
}

model InteractionLogStep {
  id          String         @id @default(cuid())
  logId       String
  description String
  metadata    Json?
  timestamp   DateTime       @default(now())
  log         InteractionLog @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId, timestamp])
  @@map("interaction_log_step")
}

model Workflow {
  id            String        @id @default(cuid())
  agentId       String
  name          String
  status        String        @default("disabled")
  blocks        Json          @default("[]")
  nodes         Json          @default("[]")
  edges         Json          @default("[]")
  createdAt     DateTime      @default(now())
  lastModified  DateTime      @updatedAt
  agent         Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runs          WorkflowRun[]

  @@index([agentId, createdAt])
  @@map("workflow")
}

model WorkflowRun {
  id                  String   @id
  workflowId          String
  status              String   @default("running")
  context             Json     @default("{}")
  currentBlockId      String?
  lastExecutedBlockId String?
  promptForUser       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  workflow            Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, updatedAt])
  @@map("workflow_run")
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  type        String
  amount      Int
  description String
  stripePaymentIntentId String?  @unique
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("credit_transaction")
}
